# Copy to .env (never commit .env). EXPO_PUBLIC_* values are compiled into the app bundle
# and visible to anyone with the app, so they must never hold secrets. Names only here.
#
# Leave EXPO_PUBLIC_API_URL unset to run in DEMO mode: built-in synthetic sample data, a visible "Demo mode" bar,
# nothing sent or saved. Set it to use the real HealthHub API (LIVE mode):
#   iOS simulator:       http://localhost:4000/api/v1
#   Android emulator:    http://10.0.2.2:4000/api/v1
#   Physical device:     http://<your-computer-LAN-IP>:4000/api/v1  (same Wi-Fi)
# Release builds must use https.
# EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
#
# Explicit mode switch (demo | live). demo ignores EXPO_PUBLIC_API_URL; live requires it.
# EXPO_PUBLIC_APP_MODE=demo

# Clerk Authentication (Get this from your Clerk Dashboard: https://dashboard.clerk.com)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

