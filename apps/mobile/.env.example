# Copy to .env (never commit .env). EXPO_PUBLIC_* values are compiled into the app bundle
# and visible to anyone with the app, so they must never hold secrets. Names only here.
#
# Base URL of the HealthHub Express API, including the /api/v1 prefix.
#   iOS simulator:       http://localhost:4000/api/v1
#   Android emulator:    http://10.0.2.2:4000/api/v1
#   Physical device:     http://<your-computer-LAN-IP>:4000/api/v1  (same Wi-Fi)
# Release builds must use https.
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
