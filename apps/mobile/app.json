{
  "expo": {
    "name": "HealthHub",
    "slug": "healthhub-mobile",
    "version": "0.1.0",
    "scheme": "healthhub",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.healthhub.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "in.healthhub.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#12355b"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f6f5f2"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "HealthHub uses the camera only when you choose to photograph a prescription to upload.",
          "photosPermission": "HealthHub reads a photo from your library only when you choose one to upload as a prescription."
        }
      ],
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "color": "#12355b"
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
