{
  "expo": {
    "name": "Sehat Meds",
    "slug": "sehat-med",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "sehatmeds",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "in.healthhub.mobile"
    },
    "android": {
      "package": "in.healthhub.mobile"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-image-picker",
      "expo-document-picker",
      "expo-notifications",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "febfa6e7-9463-49ef-912e-3e3fef6743c8"
      }
    }
  }
}