// HealthHub API schema. Contract: docs/API_CONTRACT.md v0.1.
// Decisions: apps/api/docs/CONTRACT_DECISIONS.md
//
// Conventions
// - Timestamps are timestamptz (UTC instants).
// - Enum values match the contract's wire strings exactly.
// - Extra integrity rules Prisma cannot express (CHECK constraints, append-only
//   triggers) live in prisma/migrations/*_integrity_constraints.
// - AuditEvent.metadata must hold ids and field NAMES only, never field values,
//   medical content, credentials, or tokens.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  patient
  admin
  provider
}

enum AuditOutcome {
  success
  denied
  failure
}

enum SourceType {
  uploaded_physical
  clinician_issued
}

enum ProcessingStatus {
  pending
  processing
  completed
  failed
}

enum VerificationStatus {
  unverified
  needs_review
  patient_corrected
  verified_by_authorized_clinician
}

enum VersionKind {
  extraction
  patient_correction
}

enum AppointmentStatus {
  confirmed
  cancelled
}

enum DoseStatus {
  taken
  skipped
}

enum HistoryKind {
  condition
}

enum HistorySource {
  patient_reported
}

enum VaccinationStatus {
  taken
  not_taken
}

enum FamilyRelationship {
  father
  mother
  spouse
  brother
  sister
  son
  daughter
  paternal_grandfather
  paternal_grandmother
  maternal_grandfather
  maternal_grandmother
  other
}

enum VitalStatus {
  alive
  deceased
  unknown
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String?
  clerkUserId  String?  @unique
  role         UserRole @default(patient)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  patient              Patient?
  sessions             Session[]
  consentsReceived     Consent[]             @relation("ConsentGrantee")
  auditEvents          AuditEvent[]
  versionsAuthored     PrescriptionVersion[]
  qrSessionsCreated    QrAccessSession[]
}

// Server-side session so logout can revoke a token (id is the token's jti).
model Session {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  // When the login that started this chain of refreshed sessions happened. It is copied
  // across refreshes, so a session can never be extended past an absolute maximum age.
  originAt  DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One patient row per patient user, created at registration; profile fields
// are filled in later through PATCH /patients/me.
model Patient {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String    @unique @db.Uuid
  healthId              String    @unique
  fullName              String?
  dateOfBirth           DateTime? @db.Date
  gender                String?
  bloodGroup            String?
  phone                 String?
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?
  allergies             String[]  @default([])
  existingConditions    String[]  @default([])
  currentMedications    String[]  @default([])
  address               String?
  // Private storage key, never a public URL.
  photoStorageKey       String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  user          User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  consents      Consent[]
  auditEvents   AuditEvent[]
  prescriptions PrescriptionRecord[]
  schedules     MedicationSchedule[]
  appointments  Appointment[]
  qrSessions    QrAccessSession[]
  historyEntries HealthHistoryEntry[]
  vaccinations   PatientVaccination[]
  familyMembers  FamilyMember[]
  preferredLanguage     String?  @default("en")
  timeZone              String?  @default("Asia/Kolkata")
  termsAcceptedVersion  String?
  notificationPreference NotificationPreference?
  insurancePolicies      PatientInsurancePolicy[]
  paymentOrders          PaymentOrder[]
  reviews                HospitalReview[]
}

model Consent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId     String    @db.Uuid
  granteeUserId String    @db.Uuid
  // One of: profile:read, prescriptions:read, health_history:read,
  // medication_schedules:read (enforced by a CHECK constraint).
  resourceScope String
  purpose       String
  expiresAt     DateTime? @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  grantee User    @relation("ConsentGrantee", fields: [granteeUserId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@index([granteeUserId, resourceScope])
}

// Append-only (enforced by trigger).
model AuditEvent {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt   DateTime     @default(now()) @db.Timestamptz(3)
  actorUserId  String?      @db.Uuid
  patientId    String?      @db.Uuid
  action       String
  resourceType String?
  resourceId   String?
  outcome      AuditOutcome
  requestId    String?
  metadata     Json?

  actor   User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  patient Patient? @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId, occurredAt])
  @@index([actorUserId, occurredAt])
}

// Identity, patient and original-file reference of one prescription. The
// original* columns are written once and never change (enforced by trigger).
// Extracted content lives in immutable PrescriptionVersion rows.
model PrescriptionRecord {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId         String           @db.Uuid
  sourceType        SourceType       @default(uploaded_physical)
  processingStatus  ProcessingStatus @default(pending)
  // Private storage key, never a public URL.
  originalStorageKey String          @unique
  originalFileName  String
  originalMimeType  String
  originalSizeBytes Int
  originalSha256    String
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)

  patient    Patient               @relation(fields: [patientId], references: [id], onDelete: Restrict)
  versions   PrescriptionVersion[]
  qrSessions QrAccessSession[]

  @@index([patientId, createdAt])
}

// Append-only (enforced by trigger). A new extraction run or patient correction
// always creates a new version; earlier versions are never edited or removed.
model PrescriptionVersion {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  prescriptionId       String             @db.Uuid
  versionNumber        Int
  kind                 VersionKind
  verificationStatus   VerificationStatus
  extractionProvider   String?
  extractionConfidence Float?
  prescriptionDate     DateTime?          @db.Date
  prescriberName       String?
  // Names of fields changed relative to the previous version (names only).
  changedFields        String[]           @default([])
  createdByUserId      String?            @db.Uuid
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)

  prescription PrescriptionRecord       @relation(fields: [prescriptionId], references: [id], onDelete: Restrict)
  createdBy    User?                    @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  medications  PrescriptionMedication[]

  @@unique([prescriptionId, versionNumber])
}

// Append-only (enforced by trigger). Field names follow the contract.
model PrescriptionMedication {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId    String  @db.Uuid
  position     Int
  name         String?
  strength     String?
  dose         String?
  route        String?
  frequency    String?
  duration     String?
  instructions String?
  confidence   Float

  version   PrescriptionVersion  @relation(fields: [versionId], references: [id], onDelete: Restrict)
  schedules MedicationSchedule[]

  @@unique([versionId, position])
}

// A reminder plan the patient creates from ONE medication row of a reviewed
// prescription version. The medication text (name .. instructions) is copied
// from that row and can never be edited on the schedule: changing a dose means
// correcting the prescription and creating a new schedule. Nothing here is a
// dosing instruction; it is the record's own text plus the patient's reminder
// choices. Integrity rules (time format, reminder limits) live in
// prisma/migrations/*_schedules_and_dose_events.
model MedicationSchedule {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId          String    @db.Uuid
  sourceMedicationId String    @db.Uuid
  medicationName     String
  strength           String
  dose               String
  route              String?
  frequency          String
  duration           String?
  instructions       String?
  startDate          DateTime  @db.Date
  endDate            DateTime? @db.Date
  // Local times as HH:MM (24 hour), interpreted in `timezone`.
  reminderTimes      String[]  @default([])
  remindersEnabled   Boolean   @default(false)
  timezone           String
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  patient          Patient                @relation(fields: [patientId], references: [id], onDelete: Restrict)
  sourceMedication PrescriptionMedication @relation(fields: [sourceMedicationId], references: [id], onDelete: Restrict)
  doseEvents       DoseEvent[]

  @@index([patientId, isActive])
}

// Self-reported by the patient. Append-only (trigger): events are never edited
// or deleted. One event per schedule and scheduled time.
model DoseEvent {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scheduleId   String     @db.Uuid
  scheduledFor DateTime   @db.Timestamptz(3)
  status       DoseStatus
  recordedAt   DateTime   @default(now()) @db.Timestamptz(3)

  schedule MedicationSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)

  @@unique([scheduleId, scheduledFor])
}

// PROVISIONAL fields: the contract defines no hospital fields. The final shape
// is fixed in the decision note for Milestone 9.
model Hospital {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  address     String?
  city        String?
  phone       String?
  specialties String[] @default([])
  isActive    Boolean  @default(true)
  // Seeded demo rows are labelled so they are never presented as real data.
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  slots AvailabilitySlot[]
  reviews HospitalReview[]
}

model AvailabilitySlot {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospitalId String   @db.Uuid
  startsAt   DateTime @db.Timestamptz(3)
  endsAt     DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  hospital     Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  appointments Appointment[]

  @@unique([hospitalId, startsAt])
}

// activeSlotId equals slotId while status is confirmed and is NULL otherwise
// (CHECK constraint). Its unique index guarantees at most one confirmed
// appointment per slot, even under concurrent requests.
model Appointment {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId    String            @db.Uuid
  slotId       String            @db.Uuid
  status       AppointmentStatus @default(confirmed)
  activeSlotId String?           @unique @db.Uuid
  cancelledAt  DateTime?         @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)

  patient Patient          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  slot    AvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Restrict)
  paymentOrders PaymentOrder[]

  @@index([patientId, createdAt])
  @@index([slotId])
}

// A short-lived pointer to one prescription record, shown as a QR code. The id
// is random and is the only thing in the QR: it carries no medical data and
// grants nothing by itself. Reading through it still requires a logged-in user
// who passes the normal consent check, and it stops working at expiresAt or
// once revokedAt is set (CHECK: expiresAt is after createdAt).
model QrAccessSession {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId       String    @db.Uuid
  prescriptionId  String    @db.Uuid
  createdByUserId String    @db.Uuid
  expiresAt       DateTime  @db.Timestamptz(3)
  revokedAt       DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  patient      Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  prescription PrescriptionRecord @relation(fields: [prescriptionId], references: [id], onDelete: Restrict)
  createdBy    User               @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([patientId, createdAt])
  @@index([prescriptionId])
}

// A patient-reported entry in their medical history (currently conditions). It
// is always labelled with its source and is never verified by this system.
// Append-only (trigger): entries are not edited or deleted.
model HealthHistoryEntry {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId          String             @db.Uuid
  kind               HistoryKind        @default(condition)
  title              String
  notes              String?
  diagnosedOn        DateTime?          @db.Date
  source             HistorySource      @default(patient_reported)
  verificationStatus VerificationStatus @default(unverified)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId, createdAt])
}

// Self-reported vaccination record. A patient can record whether they have taken
// a vaccine from the standard directory of vaccines in India or a custom vaccine.
model PatientVaccination {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId        String            @db.Uuid
  vaccineId        String?
  vaccineName      String
  category         String
  status           VaccinationStatus
  administeredDate DateTime?         @db.Date
  notes            String?
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@unique([patientId, vaccineName])
  @@index([patientId, createdAt])
}

// Self-reported family member and family health history. A patient can record
// relatives across generations, living status, and hereditary health conditions.
// In accordance with product safety rules, adding a family member here does not
// grant them access to the patient's records or account.
model FamilyMember {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId    String             @db.Uuid
  fullName     String
  relationship FamilyRelationship
  vitalStatus  VitalStatus        @default(alive)
  age          Int?
  bloodGroup   String?
  conditions   String[]           @default([])
  notes        String?
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId, createdAt])
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

model NotificationPreference {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId             String   @unique @db.Uuid
  emailEnabled          Boolean  @default(true)
  appointmentsEnabled   Boolean  @default(true)
  prescriptionsEnabled  Boolean  @default(true)
  medicationsEnabled    Boolean  @default(true)
  securityAlertsEnabled Boolean  @default(true)
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
}

model PatientInsurancePolicy {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId        String    @db.Uuid
  providerName     String
  policyNumber     String
  policyHolderName String?
  sumInsured       String?
  validFrom        DateTime? @db.Date
  validTill        DateTime? @db.Date
  tpaContact       String?
  notes            String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId, createdAt])
}

model PaymentOrder {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId     String        @db.Uuid
  appointmentId String?       @db.Uuid
  amountPaise   Int
  currency      String        @default("INR")
  status        PaymentStatus @default(pending)
  orderRef      String        @unique
  paymentRef    String?
  isSandbox     Boolean       @default(true)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([patientId, createdAt])
  @@index([appointmentId])
}

model HospitalReview {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospitalId        String   @db.Uuid
  patientId         String   @db.Uuid
  rating            Int
  reviewText        String?
  isVerifiedPatient Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([hospitalId, createdAt])
  @@index([patientId])
}
