# Copy to .env and fill in. Never commit .env. Names only; no real values here.
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (no wildcard).
CORS_ORIGINS=http://localhost:3000
# PostgreSQL connection string (required).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/healthhub
# Integration tests only: must point at a database whose name ends in _test.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/healthhub_test
# Rate limiting (requests per window per IP).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
