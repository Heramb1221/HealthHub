# Copy to .env and fill in. Never commit .env. Names only; no real values here.
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (no wildcard).
CORS_ORIGINS=http://localhost:3000
# PostgreSQL connection string (required).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/healthhub
# Integration tests only: must point at a database whose name ends in _test.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/healthhub_test
# Secret used to sign access tokens (required, at least 32 characters).
# Generate one with: openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=60
# Refreshing can never keep a login alive longer than this, counted from the original login.
SESSION_MAX_HOURS=168
# Development-only login shortcut for seeded demo accounts. Keep false.
# The server refuses to start with this enabled when NODE_ENV=production.
DEV_AUTH_ENABLED=false
# Max login/register requests per window per IP.
AUTH_RATE_LIMIT_MAX=10
# Private directory for uploaded prescription files (never served publicly).
# Free hosts often have ephemeral disks: files are lost on redeploy there.
STORAGE_DIR=./storage
UPLOAD_MAX_BYTES=10485760
UPLOAD_RATE_LIMIT_MAX=20
PATIENT_PRESCRIPTION_LIMIT=100
# Prescription extraction: "disabled" (refuses processing), "mock" (synthetic fixtures only),
# or "gemini" (multimodal OCR/extraction using Google Gemini Vision).
EXTRACTION_PROVIDER=disabled
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
PROCESS_RATE_LIMIT_MAX=10
# QR codes: payload = base + a random id (never medical data). QR sessions are short-lived.
QR_LINK_BASE=healthhub://
QR_SESSION_TTL_MINUTES=15
QR_RATE_LIMIT_MAX=30
# Rate limiting (requests per window per IP).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Demo data (npm run seed:demo). Never set these in a real deployment.
# DEMO_SEED_PASSWORD=
# ALLOW_DEMO_SEED=false
# Resend email configuration
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Clerk Authentication (optional; fallback to native JWT auth when unset)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Razorpay Payment Gateway (test/sandbox mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google Calendar OAuth 2.0 Integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/calendar/google/callback

# Telegram Bot Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Government Bhashini AI Translation API (Optional)
BHASHINI_API_KEY=
BHASHINI_USER_ID=


