# Copy to .env and fill in. Never commit .env. Names only; no real values here.
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (no wildcard).
CORS_ORIGINS=http://localhost:3000
# PostgreSQL connection string (required).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/healthhub
# Integration tests only: must point at a database whose name ends in _test.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/healthhub_test
# Secret used to sign access tokens (required, at least 32 characters).
# Generate one with: openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=60
# Development-only login shortcut for seeded demo accounts. Keep false.
# The server refuses to start with this enabled when NODE_ENV=production.
DEV_AUTH_ENABLED=false
# Max login/register requests per window per IP.
AUTH_RATE_LIMIT_MAX=10
# Private directory for uploaded prescription files (never served publicly).
# Free hosts often have ephemeral disks: files are lost on redeploy there.
STORAGE_DIR=./storage
UPLOAD_MAX_BYTES=10485760
UPLOAD_RATE_LIMIT_MAX=20
PATIENT_PRESCRIPTION_LIMIT=100
# Prescription extraction: "disabled" (default, refuses processing) or "mock"
# (deterministic, understands synthetic fixture documents only).
# External providers such as Gemini are NOT supported until terms and clinical
# suitability are confirmed; any other value stops the server at startup.
EXTRACTION_PROVIDER=disabled
PROCESS_RATE_LIMIT_MAX=10
# Rate limiting (requests per window per IP).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
