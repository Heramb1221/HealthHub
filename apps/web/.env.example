# apps/web environment (names only; never commit real values)

# "demo" renders with typed sample data and a visible demo banner. "live" calls the Express API.
NEXT_PUBLIC_API_MODE=demo

# Server-side only. Where the Express API runs; /api/v1/* is proxied here when NEXT_PUBLIC_API_MODE=live.
API_ORIGIN=http://localhost:4000

# Name of the API's httpOnly session cookie (must match apps/api). Used only for optimistic redirects.
AUTH_COOKIE_NAME=hh_session
